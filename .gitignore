node_modules/

# Legacy local signing keys remain ignored for safe migration. The v2.1 signing
# command rejects all in-repository keys; move them manually to offline external
# storage after verifying backups and fingerprints. Nothing moves or deletes them.
keys/

# The single executable is ~144 MB. Committing it would put that blob in git
# history permanently. Attach it to a release instead; the manifest, the
# public keys and the build recipe below stay tracked so anyone can verify it.
dist/heatdeath

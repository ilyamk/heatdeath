{
  "name": "heatdeath",
  "version": "2.1.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24.8 <27"
  },
  "//": [
    "Checkout commands run auditable source and warn that it is unsigned.",
    "Explicit :verified commands require a complete signed release first.",
    "Node's Permission Model is a seatbelt, not a malicious-code sandbox.",
    "Both modes run under the narrowest practical capability guard."
  ],
  "scripts": {
    "test": "node --test",
    "test:contracts": "node scripts/ci/check-repository.mjs && node scripts/ci/check-docs.mjs",
    "test:dependency-compat": "./scripts/ci/dependency-compat.sh",
    "test:fuzz": "node --test test/property-fuzz.test.mjs",
    "test:slow": "HEATDEATH_SLOW=1 node --test test/slow-crypto.mjs",
    "test:reproducible": "./scripts/ci/reproducible-bundle.sh",
    "self-test": "node build/run-source.mjs -- --self-test",
    "wizard": "node build/run-source.mjs -- --wizard --qr",
    "generate": "node build/run-source.mjs -- --generate",
    "generate:dice": "node build/run-source.mjs -- --generate --dice --wipe-screen",
    "generate:account": "node build/run-source.mjs -- --generate --dice --scheme=account --wipe-screen",
    "generate:private": "node build/run-source.mjs -- --generate --show-private",
    "verify": "node build/run-source.mjs -- --verify",
    "verify:account": "node build/run-source.mjs -- --verify --scheme=account",
    "split": "node build/run-source.mjs -- --split",
    "combine": "node build/run-source.mjs -- --combine",
    "op-export": "node build/run-source.mjs -- --op-export --accounts=3",
    "op-export:dry": "node build/run-source.mjs -- --op-export --accounts=3 --dry-run",
    "prove-guard": "node build/run-source.mjs -- --prove-guard",
    "prove-sandbox": "npm run prove-guard",
    "self-test:source": "node build/run-source.mjs -- --self-test",
    "wizard:source": "node build/run-source.mjs -- --wizard --qr",
    "generate:source": "node build/run-source.mjs -- --generate",
    "generate:dice:source": "node build/run-source.mjs -- --generate --dice --wipe-screen",
    "generate:account:source": "node build/run-source.mjs -- --generate --dice --scheme=account --wipe-screen",
    "generate:private:source": "node build/run-source.mjs -- --generate --show-private",
    "verify:source": "node build/run-source.mjs -- --verify",
    "verify:account:source": "node build/run-source.mjs -- --verify --scheme=account",
    "split:source": "node build/run-source.mjs -- --split",
    "combine:source": "node build/run-source.mjs -- --combine",
    "op-export:source": "node build/run-source.mjs -- --op-export --accounts=3",
    "op-export:dry:source": "node build/run-source.mjs -- --op-export --accounts=3 --dry-run",
    "prove-guard:source": "node build/run-source.mjs -- --prove-guard",
    "self-test:verified": "node build/run-verified.mjs -- --self-test",
    "wizard:verified": "node build/run-verified.mjs -- --wizard --qr",
    "generate:verified": "node build/run-verified.mjs -- --generate",
    "generate:dice:verified": "node build/run-verified.mjs -- --generate --dice --wipe-screen",
    "generate:account:verified": "node build/run-verified.mjs -- --generate --dice --scheme=account --wipe-screen",
    "generate:private:verified": "node build/run-verified.mjs -- --generate --show-private",
    "verify:verified": "node build/run-verified.mjs -- --verify",
    "verify:account:verified": "node build/run-verified.mjs -- --verify --scheme=account",
    "split:verified": "node build/run-verified.mjs -- --split",
    "combine:verified": "node build/run-verified.mjs -- --combine",
    "op-export:verified": "node build/run-verified.mjs -- --op-export --accounts=3",
    "op-export:dry:verified": "node build/run-verified.mjs -- --op-export --accounts=3 --dry-run",
    "prove-guard:verified": "node build/run-verified.mjs -- --prove-guard",
    "build": "./build/build.sh",
    "build:release": "./build/release.sh",
    "init-signing-key": "node build/sign.mjs init-signing-key",
    "sign-release": "node build/sign.mjs sign-release",
    "verify-release": "node build/verify-release.mjs"
  },
  "dependencies": {
    "@noble/curves": "2.3.0",
    "@noble/hashes": "2.3.0",
    "@scure/bip32": "2.3.0",
    "@scure/bip39": "2.3.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "fast-check": "4.9.0"
  }
}
